{  
    "compilerOptions": {
        "strict": true,
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "baseUrl": "./src",
        "paths": {
            "@/*": ["*"],
            "app/*": ["app/*"],
            "shared/*": ["shared/*"],
            "entities/*": ["entities/*"],
            "features/*": ["features/*"],
            "pages/*": ["pages/*"],
            "widgets/*": ["widgets/*"]
        },
        "ignoreDeprecations": "6.0",
         "types": ["vitest/globals", "@testing-library/jest-dom", "vite/client", "vite-plugin-svgr/client"],
    },
}
